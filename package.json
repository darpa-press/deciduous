{
  "name": "dnext",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.mts",
    "test:unit": "node --import tsx --test tests/panes.test.mts tests/content.test.mts tests/lib.test.mts",
    "test:data": "node --import tsx --test --test-concurrency=1 tests/data.test.mts tests/editor.test.mts",
    "test:site": "node --import tsx --test tests/site.test.mts",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:status": "node scripts/db.mjs status",
    "db:reset": "node scripts/db.mjs reset",
    "verify:content": "tsx scripts/verify-content-render.mts",
    "verify:data": "tsx scripts/verify-data-layer.mts",
    "verify:sanitize": "tsx scripts/test-sanitize-safety.mts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@uiw/react-codemirror": "^4.25.11",
    "@vercel/blob": "^2.8.0",
    "font-color-contrast": "^11.1.0",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "mongoose": "^8.24.4",
    "next": "16.3.2",
    "node-wordnet": "^0.1.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-select": "^5.10.2",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "server-only": "^0.0.1",
    "slugs": "^0.1.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.2",
    "wndb-with-exceptions": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/config": "^0.6.1",
    "bson": "^6.10.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "mongodb": "^6.20.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
