# ---------------------------------------------------------------- database
# Local development against a copy of live:
#   npm run db:up            # MongoDB in Docker, seeded from dump/
#   node scripts/pull-live.mjs   # or pull a fresh copy of live over it
# In production this is the Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/deciduous

# ------------------------------------------------------------------- auth
# Single admin. Generate both with:
#   node scripts/hash-password.mjs 'your password'
# The password itself is never stored, here or anywhere.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ---------------------------------------------------------------- uploads
# Vercel Blob, for media added to pieces. Create the store with
#   vercel blob store add
# then `vercel env pull`. Without it the upload route answers 501 and the rest
# of the site is unaffected. Images already published stay on S3.
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------------- site
# Canonical origin, used for the `/` redirect. Without it the redirect falls
# back to the request's own Host header, which is the caller's to choose
# anywhere the platform does not validate it.
NEXT_PUBLIC_SITE_ORIGIN=
