# Local development. Seed the database with:
#   docker run -d --name deciduous-mongo -p 27017:27017 mongo:8
#   node scripts/pull-live.mjs
MONGODB_URI=mongodb://127.0.0.1:27017/deciduous

# Single-admin auth. Generate both with:
#   node scripts/hash-password.mjs 'your password'
# The password itself is never stored.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
