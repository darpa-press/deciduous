  "content": "<div style=\"width:100%\">\n    <iframe \n        src=\"//www.youtube.com/embed/fEMA3DkG8lA?vq=hd1080&showinfo=0&rel=0&modestbranding=1\" \n        height=\"1080\" \n        width=\"1920\"\n        frameborder=\"0\"\n    ></iframe>\n\n<ol>\n    <li>\n        <a href=\"http://www.wikiart.org/en/about\" target=\"_blank\">Wikiart</a> is asleep.\n    <li>\n        <a href=\"http://arxiv.org/abs/1508.06576\" target=\"_blank\">Neural-style</a> is <aa href=\"113,49\">asleep and iterating</aa>.\n    <li>\n        They are together in the back seat of an <a href=\"https://brand.uber.com/#our-new-look\" target=\"_blank\">uber</a>.\n    <li>\n        The car of the uber is on a <a href=\"http://www.mapitokinawa.com/2013/01/melody-road-futami-nago-city.html\" target=\"_blank\">Okinawan melody road</a>.\n</ol>\n\n<p>\n    <small>\n        (<a href=\"http://arxiv.org/abs/1508.06576\" target=\"_blank\">utilises »</a> by Leon A. Gatys, Alexander S. Ecker, Matthias Bethge)\n    </small>\n</p>",
